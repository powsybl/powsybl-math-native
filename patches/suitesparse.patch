@@ -172,10 +172,10 @@
 
     option ( NMODIFY "ON: do not use Modify Module.  OFF (default): use Modify Module" off )
 
-    if ( NOT EXISTS ${CMAKE_SOURCE_DIR}/Modify )
-        # Modify module does not appear so don't use it
-        set ( NMODIFY true )
-    endif ( )
+#    if ( NOT EXISTS ${CMAKE_SOURCE_DIR}/Modify )
+#        # Modify module does not appear so don't use it
+#        set ( NMODIFY true )
+#    endif ( )
