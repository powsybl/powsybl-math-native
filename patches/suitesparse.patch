diff --color -ruN -x .idea -x cmake-build-debug SuiteSparse-7.3.1/CMakeLists.txt SuiteSparse-7.3.1.patched/CMakeLists.txt
--- SuiteSparse-7.3.1/CMakeLists.txt	1970-01-01 01:00:00.000000000 +0100
+++ SuiteSparse-7.3.1.patched/CMakeLists.txt	2026-02-16 13:57:03.619447476 +0100
@@ -0,0 +1,43 @@
+cmake_minimum_required(VERSION 3.20)
+project(SparseSuite)
+
+list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/SuiteSparse_config/cmake_modules")
+
+# Skip the BLAS/LAPACK detection: it is hard to satisfy on Windows and none of
+# the SuiteSparse modules we build need it (amd, colamd, btf, klu, cxsparse and
+# CHOLMOD without its Supernodal module - see the NSUPERNODAL setting below).
+set ( SuiteSparse_BLAS_integer "int32_t" )
+set ( BLAS_FOUND true )
+
+add_subdirectory(SuiteSparse_config/)
+add_library(SuiteSparse::SuiteSparseConfig ALIAS SuiteSparseConfig)
+add_library(SuiteSparse::SuiteSparseConfig_static ALIAS SuiteSparseConfig_static)
+
+add_subdirectory(AMD)
+add_library(SuiteSparse::AMD ALIAS AMD)
+add_library(SuiteSparse::AMD_static ALIAS AMD_static)
+
+add_subdirectory(COLAMD)
+add_library(SuiteSparse::COLAMD ALIAS COLAMD)
+add_library(SuiteSparse::COLAMD_static ALIAS COLAMD_static)
+
+add_subdirectory(BTF)
+add_library(SuiteSparse::BTF ALIAS BTF)
+add_library(SuiteSparse::BTF_static ALIAS BTF_static)
+
+add_subdirectory(KLU)
+add_library(SuiteSparse::KLU ALIAS KLU)
+add_library(SuiteSparse::KLU_static ALIAS KLU_static)
+
+add_subdirectory(CXSparse)
+add_library(SuiteSparse::CXSparse ALIAS CXSparse)
+add_library(SuiteSparse::CXSparse_static ALIAS CXSparse_static)
+
+# Force-disable CHOLMOD's Supernodal module on every platform: it is the only
+# component that needs BLAS/LAPACK. The Gauss-Newton solvers use the BLAS-free
+# simplicial factorization, which keeps the build portable (notably on Windows).
+set ( NSUPERNODAL true CACHE BOOL "Disable CHOLMOD Supernodal (avoids BLAS/LAPACK)" FORCE )
+
+add_subdirectory(CHOLMOD)
+add_library(SuiteSparse::CHOLMOD ALIAS CHOLMOD)
+add_library(SuiteSparse::CHOLMOD_static ALIAS CHOLMOD_static)
diff --color -ruN -x .idea -x cmake-build-debug SuiteSparse-7.3.1/SuiteSparse_config/CMakeLists.txt SuiteSparse-7.3.1.patched/SuiteSparse_config/CMakeLists.txt
--- SuiteSparse-7.3.1/SuiteSparse_config/CMakeLists.txt	2023-11-03 23:42:14.000000000 +0100
+++ SuiteSparse-7.3.1.patched/SuiteSparse_config/CMakeLists.txt	2026-02-16 13:52:53.862282209 +0100
@@ -62,7 +62,10 @@
     find_package ( OpenMP )
 endif ( )
 
-include ( SuiteSparseBLAS )
+## Skip the BLAS/LAPACK detection here (hard to satisfy on Windows). None of the
+## modules we build need it: amd, colamd, btf, klu, cxsparse and CHOLMOD without Supernodal.
+set ( SuiteSparse_BLAS_integer "int32_t" )
+set ( BLAS_FOUND true )
 
